{
  "expo": {
    "name": "Envelope",
    "slug": "Mobile",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sukrit04.Mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f4511e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sukrit04.Mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": [
      "mobile",
      "com.sukrit04.Mobile"
    ],
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Envelope to access your photos to scan a bill.",
          "cameraPermission": "Allow Envelope to access your camera to scan a bill."
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Fredoka_700Bold.ttf",
            "./assets/fonts/Nunito_600SemiBold.ttf",
            "./assets/fonts/Nunito_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "Envelope",
              "label": "Envelope",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "description": "What's left this month, and one-tap logging",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "EnvelopeBar",
              "label": "Envelope (bar)",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "description": "What's left this month, in one line",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "EnvelopeMini",
              "label": "Envelope (mini)",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "description": "What's left this month",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98bc9d7f-3b5c-43ee-8387-24e81a60d91c"
      }
    },
    "owner": "sukrit04"
  }
}
